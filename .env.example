# Copy to .env and adjust. All variables are optional.

# Public origin used when building customer links (no trailing slash).
# Leave empty to derive it from the incoming request (fine behind a proxy that sets X-Forwarded-*).
SBC_BASE_URL=https://support.example.com

# Shared secret for the /support/* pages. Open /support?key=<value> once; a cookie keeps you signed in.
# Leave empty ONLY for local development — otherwise anyone can create links and read incidents.
SBC_SUPPORT_ACCESS_KEY=change-me

# Link TTL limits (hours)
SBC_DEFAULT_TTL_HOURS=24
SBC_MAX_TTL_HOURS=168

# Screenshot size limit (MB)
SBC_MAX_UPLOAD_MB=8

# Host port for docker compose
SBC_PORT=8000

# Storage (defaults are fine for docker compose; for a bare `uvicorn` run they default to ./data)
# SBC_DATABASE_URL=sqlite:////data/sbc.db
# SBC_UPLOAD_DIR=/data/uploads
